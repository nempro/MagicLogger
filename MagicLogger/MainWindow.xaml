<Window x:Class="MagicLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="魔導書ログ" Icon="pack://application:,,,/MagicLogger;component/Assets/magic-scroll.ico"
        Width="1360" Height="840" MinWidth="980" MinHeight="620"
        Background="{StaticResource Night}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#151713" BorderBrush="#454A3A" BorderThickness="0,0,0,1">
      <Border.Resources>
        <Style TargetType="Button">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="SpaceFrame" Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,6" BorderBrush="Transparent" BorderThickness="1">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="Yu Gothic UI" FontSize="16" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SpaceFrame" Property="BorderBrush" Value="#7B8667"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SpaceFrame" Property="BorderBrush" Value="#D1C695"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SpaceFrame" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </Border.Resources>
      <Grid Margin="16,7">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ReaderSpaceButton" Content="魔道書" Foreground="#EFE5CD" Background="#39382C" Click="ReaderSpace_Click"/>
          <Button x:Name="WorkspaceButton" Visibility="Collapsed" Foreground="#EFE5CD" Background="Transparent" Click="Workspace_Click" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="WorkspaceCaption" Foreground="#9AA18E" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="450" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
    <Grid x:Name="GrimoireRoot" Grid.Row="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#201D19" BorderBrush="#3A332A" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="魔導書ログ" Foreground="#D8CCB4" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="  ·  静かな記録紙" Foreground="#776F63" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Column="1" Margin="16,10,20,10" MaxWidth="560">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" FontFamily="Yu Gothic UI" FontSize="13" Padding="12,7"
                   Background="#2B2721" Foreground="#D8CCB4" BorderBrush="#4B4338"
                   ToolTip="タイトル・要約・原文・Category・Tag・Index Wordを検索"
                   TextChanged="SearchBox_TextChanged" />
          <TextBlock x:Name="SearchHint" Text="記録を検索（空白でAND）…" Foreground="#756D61" FontFamily="Yu Gothic UI"
                     IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0" />
          <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" Foreground="#978B78"
                  Visibility="Collapsed" Click="ClearSearch_Click" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HomeButton" Content="⌂" Foreground="#D7C29A" FontSize="16" ToolTip="ホーム：通常の読書へ戻る (Alt+Home)" Click="Home_Click" />
          <Button x:Name="BackButton" Content="←" Foreground="#A99E8A" FontSize="16" ToolTip="戻る (Alt+←)" Click="Back_Click" />
          <Button x:Name="ForwardButton" Content="→" Foreground="#A99E8A" FontSize="16" ToolTip="進む (Alt+→)" Click="Forward_Click" />
          <Button Content="年月" Foreground="#BFB39E" Click="ToggleNav_Click" />
          <Button Content="探索" Foreground="#BFB39E" Click="ToggleContext_Click" />
          <Button x:Name="SectionButton" Content="資料" Foreground="#BFB39E" Click="ToggleSection_Click" />
          <Button x:Name="BookmarksButton" Content="しおり" Foreground="#BFB39E" Click="Bookmarks_Click" />
          <Button x:Name="RecordButton" Content="記録 ▼" Foreground="#BFB39E" Click="RecordMenu_Click">
            <Button.ContextMenu>
              <ContextMenu Background="#2B2721" BorderBrush="#5B5144" Foreground="#D8CCB4" Padding="4">
                <MenuItem Header="Exportファイルから追加" Click="Import_Click" />
                <MenuItem Header="Export一式から追加" Click="ImportFolder_Click" />
                <MenuItem Header="取込エラーを確認" Click="ImportErrors_Click" />
                <Separator />
                <MenuItem Header="将来：魔導書用まとめを追加" IsEnabled="False" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="RetryImportButton" Content="取込エラー" Foreground="#D7B77D" Visibility="Collapsed" Click="RetryImport_Click" />
          <Button x:Name="BackupButton" Content="バックアップ" Foreground="#A99E8A" Click="Backup_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="220" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="ContextColumn" Width="260" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NavPane" Grid.Column="0" Background="#211E1A" BorderBrush="#3A332A" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavContent" Margin="15,20,13,30" />
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Background="#171512">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="RawHeader" Grid.Row="0" Visibility="Collapsed" Background="#27231E"
                BorderBrush="#4A4034" BorderThickness="0,0,0,1" Padding="24,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="← 断章へ戻る" Foreground="#D8C6A8" FontSize="13" Click="CloseRaw_Click" />
            <TextBlock x:Name="RawHeaderTitle" Grid.Column="1" Foreground="#AFA18B" FontSize="12"
                       Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
        <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="ReaderScroll_ScrollChanged" PanningMode="VerticalOnly" Focusable="True">
          <Border x:Name="PaperBorder" MaxWidth="790" MinWidth="520" Margin="26,20,26,58" Padding="0"
                  BorderBrush="#625642" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0E8D8" Offset="0" />
                <GradientStop Color="#F1E9D9" Offset="0.48" />
                <GradientStop Color="#EEE4D2" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
              <Canvas IsHitTestVisible="False" Opacity="0.26">
                <!-- Small, discontinuous fibers and scuffs: no shaped mottles. -->
                <Path Stroke="#8C7654" StrokeThickness="0.38" Data="M 76,82 L119,81 M 247,128 L278,129 M 463,74 L504,75 M 618,166 L650,165 M 132,273 L170,272 M 352,318 L388,319 M 541,402 L579,401 M 93,489 L122,488 M 286,551 L326,552 M 470,625 L503,624 M 628,697 L660,698" />
                <Path Stroke="#A68C65" StrokeThickness="0.32" Data="M 104,108 L121,109 M 201,207 L224,206 M 404,256 L425,258 M 570,289 L590,288 M 44,362 L67,361 M 227,425 L247,424 M 430,484 L449,486 M 601,544 L621,543 M 166,664 L186,663" />
                <Path Stroke="#786247" StrokeThickness="0.52" Data="M 73,181 L84,180 M 317,144 L328,145 M 532,218 L543,217 M 184,342 L196,341 M 475,376 L485,377 M 342,569 L354,568 M 574,647 L587,648" />
                <!-- Tiny irregularities at the paper edge. -->
                <Path Stroke="#8B704D" StrokeThickness="0.55" Data="M 0,46 L3,51 L0,57 M 0,214 L4,219 L0,225 M 0,481 L3,486 L0,491 M 0,692 L4,697 L0,702" />
                <Path Canvas.Right="0" Canvas.Top="0" Stroke="#8B704D" StrokeThickness="0.55" Data="M 0,119 L-4,124 L0,130 M 0,354 L-3,359 L0,365 M 0,575 L-4,580 L0,586" />
              </Canvas>
              <Grid IsHitTestVisible="False">
                <Border HorizontalAlignment="Left" Width="24" Opacity="0.34">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4AB28A4F" Offset="0"/><GradientStop Color="#0CB28A4F" Offset="0.5"/><GradientStop Color="#00B28A4F" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Border HorizontalAlignment="Right" Width="23" Opacity="0.32">
                  <Border.Background><LinearGradientBrush StartPoint="1,0" EndPoint="0,0"><GradientStop Color="#46B28A4F" Offset="0"/><GradientStop Color="#0CB28A4F" Offset="0.5"/><GradientStop Color="#00B28A4F" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Border VerticalAlignment="Top" Height="18" Opacity="0.28">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38B28A4F" Offset="0"/><GradientStop Color="#00B28A4F" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Border VerticalAlignment="Bottom" Height="20" Opacity="0.31">
                  <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#3DB28A4F" Offset="0"/><GradientStop Color="#00B28A4F" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Border Margin="3" BorderBrush="#1F94754E" BorderThickness="1" />
              </Grid>
              <StackPanel x:Name="Paper" Margin="70,56,70,86" />
            </Grid>
          </Border>
        </ScrollViewer>
        <Canvas x:Name="ScrollIndicatorLayer" Grid.Row="1" Width="8" Margin="0,10,4,10"
                HorizontalAlignment="Right" Background="Transparent" Opacity="0" Cursor="SizeNS"
                PreviewMouseLeftButtonDown="ScrollIndicator_MouseLeftButtonDown"
                PreviewMouseMove="ScrollIndicator_MouseMove"
                PreviewMouseLeftButtonUp="ScrollIndicator_MouseLeftButtonUp"
                MouseLeave="ScrollIndicator_MouseLeave">
          <Border x:Name="ScrollIndicatorThumb" Width="2" Height="42" CornerRadius="1" Background="#9C7F57" />
        </Canvas>
        <StackPanel x:Name="ReaderJumpControls" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,18,20" Visibility="Collapsed" Panel.ZIndex="2">
          <StackPanel.Resources>
            <Style TargetType="Button">
              <Setter Property="Width" Value="30" />
              <Setter Property="Height" Value="30" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FontFamily" Value="Yu Gothic UI" />
              <Setter Property="Foreground" Value="#C6AA76" />
              <Setter Property="FontSize" Value="17" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="JumpFrame" Background="#2B2721" BorderBrush="#66563D" BorderThickness="1" CornerRadius="4" Opacity="0.82">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="JumpFrame" Property="BorderBrush" Value="#B99A66"/><Setter TargetName="JumpFrame" Property="Opacity" Value="1"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="JumpFrame" Property="BorderBrush" Value="#D8C6A8"/></Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="JumpFrame" Property="Opacity" Value="0.36"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </StackPanel.Resources>
          <Button x:Name="JumpToTopButton" Content="↑" ToolTip="現在の一覧の先頭へ (Home)" Click="JumpToTop_Click" />
          <Button x:Name="JumpToBottomButton" Content="↓" ToolTip="現在の一覧の末尾へ (End)" Margin="0,5,0,0" Click="JumpToBottom_Click" />
        </StackPanel>
      </Grid>

      <Border x:Name="ContextPane" Grid.Column="2" Background="#25211C" BorderBrush="#3A332A" BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="True">
          <StackPanel x:Name="ContextFacetActions" DockPanel.Dock="Top" Margin="18,12,16,0" />
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContextContent" Margin="18,12,16,30" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#201D19" BorderBrush="#3A332A" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Foreground="#8E8577" FontFamily="Yu Gothic UI" FontSize="11" Margin="18,0" VerticalAlignment="Center" Text="静かに保存されています" />
    </Border>
    </Grid>
    <ContentControl x:Name="WorkspaceHost" Grid.Row="1" Visibility="Collapsed"/>
  </Grid>
</Window>
